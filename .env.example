# ─────────────────────────────────────────────────────────────────────────────
# Shadow Monarch Bot — Environment Variables
# Copy this file to .env and fill in your values.
# NEVER commit your real .env to git.
# ─────────────────────────────────────────────────────────────────────────────

# Your Discord bot token from https://discord.com/developers/applications
# (Bot → Token → Reset Token)
DISCORD_BOT_TOKEN=your_bot_token_here

# The ID of the text channel where the bot will post quests and notifications.
# Right-click the channel in Discord → Copy Channel ID  (needs Developer Mode on)
DISCORD_CHANNEL_ID=your_channel_id_here

# ── Trading terminal (/trading) — works with no keys via Yahoo Finance
# Provider order; keyed providers are skipped when their key is blank.
# Set to "demo" for offline fake data.
MARKET_DATA_PROVIDERS=yahoo,twelvedata,alphavantage
# Twelve Data (fallback, free 800 req/day): https://twelvedata.com/account/api-keys
TWELVE_DATA_API_KEY=
# Alpha Vantage (fallback, free 25 req/day): https://www.alphavantage.co/support/#api-key
ALPHA_VANTAGE_API_KEY=

# ── Discord market brief (/signal, /brief) — Yahoo symbols, crypto as BTC-USD
MARKET_WATCHLIST=SPY,QQQ,NVDA,TSLA,BTC-USD,ETH-USD
# Posted weekdays at this time (America/New_York, 24h HH:MM)
MARKET_BRIEF_TIME=09:00
