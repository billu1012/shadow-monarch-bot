// Shadow Monarch Signals — mirrors the bias logic in trading/indicators.js
// (summarize) so TradingView and /api/market/signals agree on the same bar.
// Paste into TradingView: Pine Editor → New → replace contents → Add to chart.
//@version=6
indicator("Shadow Monarch Signals", shorttitle = "SM Signals", overlay = true)

fastLen = input.int(20, "Fast SMA")
slowLen = input.int(50, "Slow SMA")
rsiLen  = input.int(14, "RSI length")
obLevel = input.int(70, "RSI overbought")
osLevel = input.int(30, "RSI oversold")

smaFast = ta.sma(close, fastLen)
smaSlow = ta.sma(close, slowLen)
rsiVal  = ta.rsi(close, rsiLen)
[macdLine, signalLine, hist] = ta.macd(close, 12, 26, 9)

// Same scoring as the server: trend, price vs fast MA, MACD momentum, RSI extremes.
score = (smaFast > smaSlow ? 1 : -1) + (close > smaFast ? 1 : -1) + (hist > 0 ? 1 : -1) + (rsiVal >= obLevel ? -1 : 0) + (rsiVal <= osLevel ? 1 : 0)
bullish = score >= 2
bearish = score <= -2

plot(smaFast, "SMA fast", color = color.new(#f5b041, 0), linewidth = 2)
plot(smaSlow, "SMA slow", color = color.new(#5dade2, 0), linewidth = 2)
bgcolor(bullish ? color.new(#26c281, 90) : bearish ? color.new(#ef4f6b, 90) : na)

macdBullCross = ta.crossover(hist, 0)
macdBearCross = ta.crossunder(hist, 0)
plotshape(macdBullCross, "MACD bull cross", shape.triangleup, location.belowbar, color.new(#26c281, 0), size = size.small)
plotshape(macdBearCross, "MACD bear cross", shape.triangledown, location.abovebar, color.new(#ef4f6b, 0), size = size.small)

// Bias flips (fire once when the regime changes, not on every bar).
turnedBull = bullish and not bullish[1]
turnedBear = bearish and not bearish[1]
plotshape(turnedBull, "Bias → bullish", shape.labelup, location.belowbar, color.new(#7b5cff, 0), text = "BULL", textcolor = color.white)
plotshape(turnedBear, "Bias → bearish", shape.labeldown, location.abovebar, color.new(#7b5cff, 0), text = "BEAR", textcolor = color.white)

alertcondition(turnedBull, "SM: bias turned bullish", "{{ticker}} bias turned BULLISH at {{close}}")
alertcondition(turnedBear, "SM: bias turned bearish", "{{ticker}} bias turned BEARISH at {{close}}")
alertcondition(macdBullCross, "SM: MACD bullish cross", "{{ticker}} MACD bullish cross at {{close}}")
alertcondition(macdBearCross, "SM: MACD bearish cross", "{{ticker}} MACD bearish cross at {{close}}")
alertcondition(ta.crossover(rsiVal, osLevel), "SM: RSI leaving oversold", "{{ticker}} RSI crossed above oversold at {{close}}")
alertcondition(ta.crossunder(rsiVal, obLevel), "SM: RSI leaving overbought", "{{ticker}} RSI crossed below overbought at {{close}}")
